#include <stdio.h>
#include<stdlib.h>
struct node{
    int data;
    struct node*next;
};
struct node*head=NULL;
struct node*create(){
    struct node*newnode,*temp;
    int data;
    newnode=(struct node*)malloc(sizeof(struct node));
    printf("Enter the data you want to insert : ");
    scanf("%d",&data);
    newnode->data=data;
    newnode->next=NULL;
    
return newnode;
}
void insertBeginning(){
    struct node*newnode;
    newnode=create();
    if(head==NULL){
        head=newnode;
    }
    else{
        newnode->next=head;
        head=newnode;
    }
    printf("Node inserted successfully\n");
    }
    void insertEnd(){
        struct node*new,*temp;
        new=create();
        if(head==NULL){
            head=new;
        }
        else{
            temp=head;
            while(temp->next!=NULL){
                temp=temp->next;
         
            }
            temp->next=new;
        }
        printf("Node inserted successfully\n");
    }
    void insertPosition(){
        struct node*newnode,*temp;
        newnode=create();
        int pos,i;
        if(pos==1){
            newnode->next=head;
            head=newnode;
        }
        else{
            temp=head;
        printf("Enter the position at which you want to insert the data : ");
        scanf("%d",&pos);
        for(i=1;i<pos-1;i++){
            temp=temp->next;
        }
        if(temp==NULL){
            printf("Invalid position\n");
            free(newnode);
        }
        newnode->next=temp->next;
        temp->next=newnode;
        }
    }
    void deleteBeginning(){
        struct node*temp;
        if(head==NULL){
        printf("List is empty");
        }
        else{
            temp=head;
            head=head->next;
            free(temp);
            printf("Node deleted successfully\n");
            
        }
    }
    void deleteEnd(){
        struct node*temp,*prev;
        if(head==NULL){
            printf("List is empty\n");
        }
    else if(head->next==NULL)
    {
        free(head);
        head=NULL;
    }
    else{
        temp=head;
        while(temp->next->next!=NULL){
            temp=temp->next;
        }
        prev=temp->next;
        temp->next=NULL;
        free(prev);
        printf("Node deleted successfully\n");
    }
    }
    void deleteAtPos(){
        struct node*temp,*delnode;
        int pos,i;
        if(head==NULL){
            printf("List is empty\n");
            return;
        }
        temp=head;
        if(temp->next==NULL){
            head=NULL;
            free(temp);
            return;
        }
        printf("Enter position\n");
        scanf("%d",&pos);
        if(pos==1){
            deleteBeginning();
        }
        else{
            for(i=1;i<pos-1;i++){
                temp=temp->next;
                if(temp==NULL){
                    printf("Cannot delete\n");
                    return;
                }
            }
            delnode=temp->next;
            temp->next=delnode->next;
            free(delnode);
        }
    }
    void display(){
        struct node*temp;
   if(head==NULL){
       printf("List is empty\n");
   }
    
    else{
        temp=head;
        printf("Linked list:\n");
        while(temp!=NULL){
            printf("%d->",temp->data);
            temp=temp->next;
        }
        printf("NULL\n");
    }
    }
    int main(){
        int choice;
       printf("1.Insert at begining\n");
       printf("2.insert at end\n");
       printf("3.Insert at position\n");
       printf("4.Delete from beginning\n");
       printf("5.Delete from end");
       printf("6.Delete from position\n");
       printf("7.Exit\n");
       while(1){
       printf("Enter your choice : \n");
       scanf("%d",&choice);
       switch(choice){
           case 1: 
           insertBeginning();
           break;
           case 2:
           insertEnd();
           break;
          case 3:
         insertPosition();
        break;
          case 4:
           deleteBeginning();
         break;
           case 5:
          deleteEnd();
         break;
          case 6:
         deleteAtPos();
         break;
        case 7:
         display();
          break;
 case  8:
      exit(0);
          default:
          printf("Invalid choice\n");
       }
       }
       return 0;
    }
