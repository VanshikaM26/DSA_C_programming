#include <stdio.h>
#define SIZE 5
int queue [SIZE];
int rear=-1,front=-1;
void enqueue(int x){
    if(rear==SIZE-1){
        printf("queue overflow");
    }
    else{
        if(front==-1)
        front=0;
        rear++;
        queue[rear]=x;
        printf("%d inserted\n",x);
        }
    }
void dequeue(){
    if(front==-1 || front>rear){
        printf("Queue underflow\n");
    }
    else{
        printf("%d deleted\n",queue[front]);
        front++;
        if(front>rear)
        front=rear=-1;
    }
    }
    void display(){
        int i;
        if(front==-1){
            printf("Queue is empty\n");
        }
        else{
            printf("Queue elements : ");
            for(i=front;i<=rear;i++){
                printf("%d ",queue[i]);
                
                
            }
            printf("\n");
        }
    }
int main(){
    enqueue(10);
    enqueue(20);
    enqueue(30);
    display();
    dequeue();
    display();
    return 0;
}
